#!/bin/sh
# Managed by `cargo lid-rs sync`; do not edit. Runs `cargo lid-rs "$@"` from
# the repository root. The tool's own workspace — the only repository with
# cargo-lid-rs/Cargo.toml at its root — runs it from source, so its hooks
# exercise the working tree; every other project runs the installed binary.
set -e
top="$(git rev-parse --show-toplevel)"
cd "$top"
if [ -f "$top/cargo-lid-rs/Cargo.toml" ]; then
  exec cargo run -q -p cargo-lid-rs -- "$@"
fi
exec cargo lid-rs "$@"
